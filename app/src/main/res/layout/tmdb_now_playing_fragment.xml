<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    tools:context=".presentation.modules.dashboard.screens.TMDBHomeFragment">

    <ImageView
        android:id="@+id/theatre_image"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        tools:src="@drawable/onboarding_1"
        android:scaleType="fitXY"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/theatre_background"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="fitXY"
        android:src="@drawable/theatre_background"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="130dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/theatre_recycler"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/theatre_background" />


</androidx.constraintlayout.widget.ConstraintLayout>